# Copy to `.env.local` and fill in from Supabase: Project Settings → API
# Project URL → VITE_SUPABASE_URL
# anon public → VITE_SUPABASE_ANON_KEY (safe for browser; never commit real keys to git)

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Data source strategy:
# - mock (default): uses local mock stores + local orders
# - supabase: reads/writes stores/orders from Supabase when keys are configured
VITE_DATA_SOURCE=mock
